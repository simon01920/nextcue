# Copy to .env (git-ignored) and fill in. Keys are passed to the app at build time:
#   flutter run --dart-define-from-file=.env
TVDB_API_KEY=your-tvdb-v4-api-key
CLAIMED_EMAILS=you@example.com

# Firebase API keys (project nextcue-5085d). Never commit them.
# tools/firebase_env.sh fills these in from the Firebase project.
FIREBASE_WEB_API_KEY=
FIREBASE_ANDROID_API_KEY=
FIREBASE_IOS_API_KEY=
