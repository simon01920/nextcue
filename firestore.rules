rules_version = '2';

// NextCue: each signed-in user owns exactly one document, users/{uid},
// written by lib/services/cloud_sync.dart. Everything else is closed.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validUserDoc();
    }

    // Default deny for every other path.
    match /{document=**} {
      allow read, write: if false;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Only the fields the app writes, with the right types.
    function validUserDoc() {
      let d = request.resource.data;
      return d.keys().hasOnly(['schema', 'updatedAt', 'state'])
        && d.schema is int
        && d.updatedAt == request.time
        && d.state is map
        && d.state.keys().hasOnly([
             'watched', 'favorites', 'ratings', 'reactions', 'devices',
             'favChars', 'lastWatched', 'watchedAt', 'statuses', 'posters',
             'banners', 'themeMode'
           ]);
    }
  }
}
